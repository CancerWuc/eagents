{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "description",
    "version",
    "supportedInterfaces",
    "capabilities",
    "skills",
    "defaultInputModes",
    "defaultOutputModes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "supportedInterfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "protocolVersion",
          "protocolBinding"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "protocolVersion": {
            "const": "1.0"
          },
          "protocolBinding": {
            "const": "JSONRPC"
          }
        }
      }
    },
    "capabilities": {
      "type": "object"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "tags"
        ],
        "properties": {
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "defaultInputModes": {
      "type": "array",
      "minItems": 1
    },
    "defaultOutputModes": {
      "type": "array",
      "minItems": 1
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "url"
        ]
      },
      {
        "required": [
          "protocolVersion"
        ]
      },
      {
        "required": [
          "preferredTransport"
        ]
      },
      {
        "required": [
          "additionalInterfaces"
        ]
      },
      {
        "required": [
          "x-eagent-args-keys"
        ]
      }
    ]
  },
  "$id": "https://eagent.example/contracts/agent-card.v1.schema.json"
}