# Copy to backend/.env.local and fill in your own local credentials.
MYSQL_ROOT_PASSWORD=
EAGENT_DB_HOST=127.0.0.1
EAGENT_DB_PORT=3306
EAGENT_DB_USER=eagent_github
EAGENT_DB_PASSWORD=
EAGENT_DB_NAME=eagent_github
EAGENT_AUTH_MODE=strict
EAGENT_ADMIN_TOKEN=
ADMIN_PASSWORD=
EAGENT_PUBLIC_URL=http://localhost:8189
# Default LLM provider: DeepSeek (OpenAI-compatible). Put your DeepSeek key here.
EAGENT_LLM_API_KEY=
EAGENT_LLM_BASE_URL=https://api.deepseek.com
EAGENT_LLM_MODEL=deepseek-chat
EAGENT_LLM_PROVIDER_NAME=deepseek
HIAGENT_URL=
HIAGENT_API_KEY=
# Optional host ports for Docker Compose; change them if already occupied.
EAGENT_BACKEND_PORT=8189
EAGENT_FRONTEND_PORT=5174
